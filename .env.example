# Local development. Never commit real credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./bot_kripto.db
API_URL=http://localhost:8000
DOMAIN=http://localhost:8000
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_DAILY_TOKEN_LIMIT=200000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_BUDGET_DB=.local/openai_budget.sqlite3
OPENAI_HTTP_EXPLANATIONS_ENABLED=false
ETHERSCAN_API_KEY=
REDIS_URL=redis://localhost:6379/0
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={}
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CURRENCY=RUB
YOOKASSA_RETURN_PATH=/payments/return
YOOKASSA_PRICES={}
